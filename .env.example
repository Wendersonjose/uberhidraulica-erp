# Copie para .env, preencha e NUNCA commite o .env real (já está no .gitignore).
# Os segredos abaixo estão VAZIOS de propósito: o `docker compose` recusa subir enquanto faltarem, e nenhum
# valor de exemplo funciona como senha. Gere cada um com:  openssl rand -base64 24

# ---------------------------------------------------------------- perfil Spring
# prod  = cookie de sessão Secure (exige HTTPS na frente) + IP real atrás do proxy. É o padrão.
SPRING_PROFILES_ACTIVE=prod
# Cookie de sessão Secure. Mantenha `true`. Somente homologação em HTTP puro pode usar `false` (sem HTTPS o
# navegador descarta o cookie Secure e ninguém consegue logar). NUNCA use `false` em produção.
SESSION_COOKIE_SECURE=true
# Porta publicada pelo frontend (nginx).
HTTP_PORT=80

# ---------------------------------------------------------------- banco de dados (container postgres)
# O mesmo trio cria o banco no container postgres e é usado pelo backend.
DB_NAME=uberhidraulica
DB_USERNAME=uberhidraulica
DB_PASSWORD=

# ---------------------------------------------------------------- bootstrap do primeiro Dono
# Só é usado quando ainda não existe nenhum usuário (DR-0002). A senha precisa ter de 8 a 72 caracteres, é
# provisória (o primeiro login exige trocá-la) e as três variáveis podem ser removidas depois disso.
IAM_BOOTSTRAP_OWNER_NAME=
IAM_BOOTSTRAP_OWNER_EMAIL=
IAM_BOOTSTRAP_OWNER_PASSWORD=

# ---------------------------------------------------------------- alternativa: PostgreSQL gerenciado (Supabase)
# Só se SPRING_PROFILES_ACTIVE=prod,supabase. Nesse caso o banco é o gerenciado e o container postgres do
# compose fica ocioso. Use Session pooler (porta 5432) ou conexão direta — nunca o Transaction pooler (6543) —
# e mantenha sslmode=require. As tabelas de negócio continuam nos schemas próprios; o schema técnico abaixo
# guarda apenas o flyway_schema_history.
# SUPABASE_DB_URL=jdbc:postgresql://SEU-HOST-SESSION-POOLER:5432/postgres?sslmode=require
# SUPABASE_DB_USERNAME=postgres.SEU_PROJECT_REF
# SUPABASE_DB_PASSWORD=
# FLYWAY_DEFAULT_SCHEMA=erp_meta

# ---------------------------------------------------------------- execução local fora do Docker
# Backend (mvn spring-boot:run) com o banco do compose.dev.yaml. Valores padrão de desenvolvimento, só para a
# sua máquina; o perfil prod exige DB_PASSWORD explícito.
# DB_HOST=localhost
# DB_PORT=5432
# SERVER_PORT=8080
