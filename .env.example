# Copie para .env, preencha e NUNCA commite o .env real (já está no .gitignore).
# Todo valor aqui é exemplo/placeholder — troque antes de subir qualquer ambiente real.

# ---------------------------------------------------------------- perfil Spring
# PostgreSQL local/Docker:
# SPRING_PROFILES_ACTIVE=prod
# Supabase gerenciado (recomendado enquanto o Docker local estiver indisponível):
SPRING_PROFILES_ACTIVE=prod,supabase

# ---------------------------------------------------------------- banco de dados local/Docker
# Usado quando o profile `supabase` NÃO estiver ativo.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=uberhidraulica
DB_USERNAME=uberhidraulica
DB_PASSWORD=troque-esta-senha

# ---------------------------------------------------------------- Supabase PostgreSQL
# Obtenha os valores em Supabase > Connect.
# Para Spring/Hibernate, use Session pooler (porta 5432) ou conexão direta.
# Não use Transaction pooler (porta 6543) como datasource principal.
# Mantenha sslmode=require na URL.
SUPABASE_DB_URL=jdbc:postgresql://SEU-HOST-SESSION-POOLER:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres.SEU_PROJECT_REF
SUPABASE_DB_PASSWORD=troque-esta-senha
# Schema técnico apenas para flyway_schema_history; as tabelas de negócio continuam nos schemas
# próprios (iam, crm, servicecatalog, productcatalog, workorder, inventory, workshop, finance etc.).
FLYWAY_DEFAULT_SCHEMA=erp_meta

# ---------------------------------------------------------------- servidor
SERVER_PORT=8080

# ---------------------------------------------------------------- bootstrap do primeiro Dono
# Só é usado quando ainda não existe nenhum usuário (DR-0002). Troque a senha no primeiro login;
# depois disso estas variáveis podem ser removidas do ambiente sem efeito algum.
IAM_BOOTSTRAP_OWNER_NAME=
IAM_BOOTSTRAP_OWNER_EMAIL=
IAM_BOOTSTRAP_OWNER_PASSWORD=

# ---------------------------------------------------------------- Postgres (container oficial)
# Usadas apenas pelo serviço `postgres` do docker-compose.yml para criar o banco inicial; mantenha
# iguais a DB_NAME/DB_USERNAME/DB_PASSWORD acima quando usar Docker.
POSTGRES_DB=uberhidraulica
POSTGRES_USER=uberhidraulica
POSTGRES_PASSWORD=troque-esta-senha
