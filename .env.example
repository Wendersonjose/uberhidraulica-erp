# Copie para .env, preencha e NUNCA commite o .env real (já está no .gitignore).
# Todo valor aqui é exemplo/placeholder — troque antes de subir qualquer ambiente real.

# ---------------------------------------------------------------- perfil Spring
SPRING_PROFILES_ACTIVE=prod

# ---------------------------------------------------------------- banco de dados
DB_HOST=postgres
DB_PORT=5432
DB_NAME=uberhidraulica
DB_USERNAME=uberhidraulica
DB_PASSWORD=troque-esta-senha

# ---------------------------------------------------------------- servidor
SERVER_PORT=8080

# ---------------------------------------------------------------- bootstrap do primeiro Dono
# Só é usado quando ainda não existe nenhum usuário (DR-0002). Troque a senha no primeiro login;
# depois disso estas variáveis podem ser removidas do ambiente sem efeito algum.
IAM_BOOTSTRAP_OWNER_NAME=
IAM_BOOTSTRAP_OWNER_EMAIL=
IAM_BOOTSTRAP_OWNER_PASSWORD=

# ---------------------------------------------------------------- Postgres (container oficial)
# Usadas apenas pelo serviço `postgres` do docker-compose.yml para criar o banco inicial; mantenha
# iguais a DB_NAME/DB_USERNAME/DB_PASSWORD acima.
POSTGRES_DB=uberhidraulica
POSTGRES_USER=uberhidraulica
POSTGRES_PASSWORD=troque-esta-senha
